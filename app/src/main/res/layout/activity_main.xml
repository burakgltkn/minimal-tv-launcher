<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/root_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="#0B0D10"
        android:padding="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="18dp">

            <TextView
                android:id="@+id/btn_hdmi"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="HDMI"
                android:textColor="#E5E7EB"
                android:textSize="13sp"
                android:paddingLeft="12dp"
                android:paddingRight="12dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:layout_marginRight="8dp"
                android:focusable="true"
                android:clickable="true"
                android:background="@drawable/btn_selector" />

            <TextView
                android:id="@+id/btn_ram_clean"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="RAM"
                android:textColor="#E5E7EB"
                android:textSize="13sp"
                android:paddingLeft="12dp"
                android:paddingRight="12dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:layout_marginRight="8dp"
                android:focusable="true"
                android:clickable="true"
                android:background="@drawable/btn_selector" />

            <TextView
                android:id="@+id/btn_dim"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Parlaklık"
                android:textColor="#E5E7EB"
                android:textSize="13sp"
                android:paddingLeft="12dp"
                android:paddingRight="12dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:layout_marginRight="8dp"
                android:focusable="true"
                android:clickable="true"
                android:background="@drawable/btn_selector" />

            <TextView
                android:id="@+id/btn_blackout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Karart"
                android:textColor="#E5E7EB"
                android:textSize="13sp"
                android:paddingLeft="12dp"
                android:paddingRight="12dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:layout_marginRight="8dp"
                android:focusable="true"
                android:clickable="true"
                android:background="@drawable/btn_selector" />

            <TextView
                android:id="@+id/btn_tools"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Araçlar"
                android:textColor="#E5E7EB"
                android:textSize="13sp"
                android:paddingLeft="12dp"
                android:paddingRight="12dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:focusable="true"
                android:clickable="true"
                android:background="@drawable/btn_selector" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="end"
                android:layout_marginRight="16dp">

                <TextView
                    android:id="@+id/net_info"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#9CA3AF"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/ram_info"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#6B7280"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextClock
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:format24Hour="HH:mm"
                android:textColor="#F3F4F6"
                android:textSize="26sp" />
        </LinearLayout>

        <GridView
            android:id="@+id/app_grid"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:numColumns="5"
            android:horizontalSpacing="16dp"
            android:verticalSpacing="16dp"
            android:listSelector="@drawable/focus_selector"
            android:drawSelectorOnTop="true" />
    </LinearLayout>

    <View
        android:id="@+id/dim_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000"
        android:alpha="0.0"
        android:clickable="false"
        android:focusable="false" />
</FrameLayout>
